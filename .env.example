# Copie para .env e preencha. Nunca commite o .env.
POSTGRES_DB=promo
POSTGRES_USER=promo
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000

# Fontes de oferta (ver docs/operacao/fontes.md). Chave que cifra as credenciais das fontes no banco:
#   openssl rand -base64 32      (guarde fora do repositório; perder a chave obriga a regravar as credenciais)
CREDENTIALS_KEY=
CREDENTIALS_KEY_VERSION=v1
# Segredos de cada fonte, só para gravar com pipeline/credencial.js --de-ambiente (FONTE_<FONTE>_<CAMPO>):
# FONTE_LOMADEE_APIKEY=


# Login por e-mail da API (docs/operacao/login-por-email.md). Sem AUTH_HMAC_KEY e um provedor, o login fica desligado.
#   openssl rand -base64 32      (guarde fora do repositório; trocar a chave invalida só os códigos em andamento)
AUTH_HMAC_KEY=
# Produção: conta da Brevo e remetente verificado. Desenvolvimento: AUTH_EMAIL_CONSOLE=1 escreve o código no log (nunca em produção).
BREVO_API_KEY=
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=economae
AUTH_EMAIL_CONSOLE=
# 1 quando a API fica atrás de um proxy confiável (Cloudflare Tunnel): usa X-Forwarded-For para o IP do limite de taxa.
TRUST_PROXY=

# Coleta de preços no seu computador (docs/operacao/instalar-no-seu-computador.md):
COMPOSE_PROFILES=coleta
TENANT=padrao
INTERVALO_COLETA_MIN=120
