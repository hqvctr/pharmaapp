# Copie para .env e preencha. Nunca commite o .env.
POSTGRES_DB=promo
POSTGRES_USER=promo
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
# Chave do HMAC dos códigos de login (32+ caracteres aleatórios):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_CODIGO_CHAVE=
# E-mail do código de login. log (só desenvolvimento) ou brevo (produção). Ver docs/operacao/google-cloud.md.
EMAIL_MODO=log
# BREVO_API_KEY=
# EMAIL_REMETENTE=nao-responda@seu-dominio
# EMAIL_REMETENTE_NOME=economae
# EMAIL_LIMITE_DIARIO=280
# Push. log (só desenvolvimento) ou fcm (produção, com o JSON da conta de serviço do Firebase fora do git).
FCM_MODO=log
# FCM_CONTA_SERVICO=/caminho/fora-do-repositorio/conta-servico.json
