{
  "name": "promo-alertas-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src",
    "migrate": "node dist/db/migrate.js",
    "start:api": "node dist/api/server.js",
    "contrato": "tsc -p tsconfig.json && node dist/api/gerarContrato.js"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.15.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
